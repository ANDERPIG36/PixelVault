@page "{id}"
@model PixelVault.Pages.Games.EditModel
@{
    ViewData["Title"] = "Modifica Gioco";
}

<h1 class="mb-4">Modifica Gioco</h1>

<div class="row">
    <div class="col-md-8">
        <form method="post">
            <input type="hidden" asp-for="Game.Id" />
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Game.Title" class="form-label font-weight-bold">Titolo</label>
                <input asp-for="Game.Title" class="form-control" />
                <span asp-validation-for="Game.Title" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label class="form-label font-weight-bold">Generi</label>
                <select asp-for="SelectedGenreIds" asp-items="Model.GenresList" class="form-select" multiple size="5">
                </select>
                <small class="form-text text-muted">Tieni premuto CTRL (o CMD su Mac) per selezionare più generi.</small>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Game.DeveloperId" class="form-label font-weight-bold">Sviluppatore</label>
                    <select asp-for="Game.DeveloperId" asp-items="Model.DevelopersList" class="form-select">
                        <option value="">-- Seleziona Sviluppatore --</option>
                    </select>
                    <span asp-validation-for="Game.DeveloperId" class="text-danger"></span>
                </div>

                <div class="col-md-6 mb-3">
                    <label asp-for="Game.PublisherId" class="form-label font-weight-bold">Editore</label>
                    <select asp-for="Game.PublisherId" asp-items="Model.PublishersList" class="form-select">
                        <option value="">-- Seleziona Editore --</option>
                    </select>
                    <span asp-validation-for="Game.PublisherId" class="text-danger"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="Game.Price" class="form-label font-weight-bold">Prezzo (€)</label>
                    <input asp-for="Game.Price" class="form-control" type="number" step="0.01" />
                    <span asp-validation-for="Game.Price" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Game.Discount" class="form-label font-weight-bold">Sconto (%)</label>
                    <input asp-for="Game.Discount" class="form-control" type="number" step="1" min="0" max="100" />
                    <span asp-validation-for="Game.Discount" class="text-danger"></span>
                </div>

                <div class="col-md-4 mb-3">
                    <label asp-for="Game.Rating" class="form-label font-weight-bold">Valutazione</label>
                    <input asp-for="Game.Rating" class="form-control" type="number" step="0.1" min="0" max="10" />
                    <span asp-validation-for="Game.Rating" class="text-danger"></span>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="Game.ReleaseDate" class="form-label font-weight-bold">Data di Uscita</label>
                <input asp-for="Game.ReleaseDate" class="form-control" type="date" />
                <span asp-validation-for="Game.ReleaseDate" class="text-danger"></span>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary">Salva Modifiche</button>
                <a asp-page="Index" class="btn btn-secondary">Annulla</a>
            </div>
        </form>
    </div>
</div>