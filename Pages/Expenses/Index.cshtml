@page
@model PixelVault.Pages.ExpensesPage.IndexModel
@{
    ViewData["Title"] = "Gestione Spese Uscite";
}

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm mb-3">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0">💸 Registra Nuova Spesa</h5>
            </div>
            <div class="card-body">
                <form method="post">
                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Descrizione *</label>
                        <input asp-for="NewExpense.Description" class="form-control" placeholder="Es. Affitto locale, Bolletta luce..." required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Categoria *</label>
                        <select asp-for="NewExpense.Category" class="form-select" required>
                            <option value="">-- Seleziona Categoria --</option>
                            <option value="Utenze">Utenze (Luce, Gas, Internet)</option>
                            <option value="Affitto">Affitto / Struttura</option>
                            <option value="Fornitori">Fornitori / Inventario</option>
                            <option value="Stipendi">Stipendi / Personale</option>
                            <option value="Marketing">Marketing / Pubblicità</option>
                            <option value="Altro">Altro</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Importo (€) *</label>
                        <input asp-for="NewExpense.Amount" type="number" step="0.01" min="0.01" class="form-control" placeholder="0.00" required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label font-weight-bold">Data Spesa *</label>
                        <input asp-for="NewExpense.Date" type="date" class="form-control" required />
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Salva Spesa</button>
                </form>
            </div>
        </div>
    </div>

    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0">📄 Registro Uscite</h5>
                <span class="badge bg-warning text-dark fs-6">Totale Spese: € @Model.TotalExpensesSum.ToString("0.00")</span>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-striped table-hover align-middle mb-0">
                        <thead class="table-secondary">
                            <tr>
                                <th>Data</th>
                                <th>Descrizione</th>
                                <th>Categoria</th>
                                <th>Importo</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!Model.ExpensesList.Any()) {
                                <tr>
                                    <td colspan="4" class="text-center py-4 text-muted">
                                        Nessuna spesa registrata.
                                    </td>
                                </tr>
                            }
                            else {
                                @foreach (var expense in Model.ExpensesList) {
                                    <tr>
                                        <td>@expense.Date.ToString("dd/MM/yyyy")</td>
                                        <td class="fw-bold">@expense.Description</td>
                                        <td><span class="badge bg-outline-dark text-dark border">@expense.Category</span></td>
                                        <td class="fw-bold text-danger">€ @expense.Amount.ToString("0.00")</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>